# Firebase Client SDK Configuration (Ensure these start with NEXT_PUBLIC_)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID

# Backend API URL (Used by the client-side to reach Next.js API routes)
# Typically the same URL as your Next.js app during development
NEXT_PUBLIC_API_URL=http://localhost:9002

# Socket.IO Server URL (Points to the integrated Next.js API route handling sockets)
# Typically the same URL as your Next.js app during development
NEXT_PUBLIC_SOCKET_URL=http://localhost:9002

# Google Generative AI API Key (for Genkit/Gemini)
GOOGLE_GENAI_API_KEY=YOUR_GOOGLE_GENAI_API_KEY

# Firebase Admin SDK Configuration (Used by backend API routes - DO NOT prefix with NEXT_PUBLIC_)
# Provide the *content* of your service account key JSON file, base64 encoded.
# This is generally more secure than referencing a file path, especially in hosted environments.
# Example (Linux/macOS): base64 -w 0 path/to/your/serviceAccountKey.json
FIREBASE_ADMIN_SDK_CONFIG_BASE64=YOUR_BASE64_ENCODED_SERVICE_ACCOUNT_JSON

# JWT Secret Key (Used by API routes for signing/verifying tokens)
JWT_SECRET=YOUR_VERY_SECRET_RANDOM_STRING_FOR_JWT # Replace with a strong, random secret

# Server Port (Optional - Used by 'next start' in production if not set elsewhere)
# PORT=9002
