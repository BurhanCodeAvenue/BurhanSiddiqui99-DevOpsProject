# Firebase Admin SDK Configuration (Used by the backend server - DO NOT prefix with NEXT_PUBLIC_)
# Option 1: Path to your service account key JSON file
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./path/to/your/serviceAccountKey.json

# Option 2: Base64 encoded service account key JSON content (more secure for some environments)
FIREBASE_ADMIN_SDK_CONFIG_BASE64=""

# IMPORTANT: If using Option 1, ensure the JSON file is NOT committed to Git.
# IMPORTANT: If using Option 2, generate the base64 string from your service account JSON.
#            Example (Linux/macOS): base64 -w 0 path/to/your/serviceAccountKey.json

